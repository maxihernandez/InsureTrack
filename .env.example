# Server-only: use the Supabase Transaction pooler connection string.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require
# Server-only Storage access for private profile photos. Use a Supabase secret key; never expose it as NEXT_PUBLIC_.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SECRET_KEY=sb_secret_[your-secret-key]
